# Runtime Garden Social Studio — environment template (copy to .env, fill in).
# NEVER commit .env. RG_ADMIN_* must be set together or the server refuses to
# start with an empty database (see apps/web/src/server.ts).

# First-start admin. Change immediately; used only when the users table is empty.
RG_ADMIN_USERNAME=owner
RG_ADMIN_PASSWORD=change-me-now

# Listen address / port (container default: 0.0.0.0:8787).
RG_HOST=0.0.0.0
RG_PORT=8787

# Session length in milliseconds (default: 12h).
# RG_SESSION_TTL_MS=43200000

# SQLite database file inside the container volume.
RG_DB_PATH=/app/data/studio.sqlite

# Set to 1 only when terminating TLS in front of the app; forces Secure cookies.
# RG_SECURE_COOKIES=0
